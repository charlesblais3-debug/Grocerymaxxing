# Pushing a change to this file starts a full "gather" run (flyers + baseline + recipes).
# SOURCES: comma-separated ids from scripts/sources.mjs (empty = all). TARGET_SCALE: multiplier on targets.
# MAX_ITEM_LOOKUPS: cap on flyer item detail lookups for this run.
SOURCES=
TARGET_SCALE=0.1
MAX_ITEM_LOOKUPS=150
